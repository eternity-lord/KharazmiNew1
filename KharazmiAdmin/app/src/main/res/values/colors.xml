    <!-- ==================== DESIGN SYSTEM (Phase 1) — SEMANTIC TOKENS ====================
         این بلوک «معنایی» است و توکن‌های تزئینی موجود (gold_*) دست‌نخورده می‌مانند.
         قاعده: رنگ معنایی = وضعیت (موفق/هشدار/خطر/اطلاع/بدهی/اعتبار)، رنگ تزئینی = برند/طلایی.
         هیچ‌کدام از رنگ‌های قدیمی حذف نشده‌اند تا صفحات قدیمی سالم بمانند. -->

    <!-- FIX: item_dunning_draft.xml این رنگ را ارجاع می‌داد ولی هیچ‌جا تعریف نشده بود (خطای resource linking).
         مقدار آن با رنگ سطوح محوِ موجود هم‌خانواده انتخاب شده است. -->
    <color name="gold_bg_subtle">#F3F4F6</color>

    <!-- سطوح (از کم‌عمق به عمیق) -->
    <color name="ds_bg_base">@color/gold_bg_base</color>
    <color name="ds_bg_surface">@color/gold_bg_elevated</color>
    <color name="ds_bg_surface_2">@color/gold_bg_elevated_2</color>
    <color name="ds_bg_surface_3">#E8ECF2</color>
    <color name="ds_bg_surface_disabled">@color/gold_button_disabled_bg</color>
    <color name="ds_border">@color/gold_border_subtle</color>
    <color name="ds_border_strong">#AAB4C3</color>

    <!-- اکسنت برند (طلایی) — محدود و هدفمند -->
    <color name="ds_accent">@color/gold_primary</color>
    <color name="ds_accent_strong">@color/gold_primary_dark</color>
    <color name="ds_on_accent">@color/text_on_gold</color>

    <!-- متن -->
    <color name="ds_text_primary">@color/text_primary</color>
    <color name="ds_text_secondary">@color/text_secondary</color>
    <color name="ds_text_disabled">@color/text_disabled</color>

    <!-- معنایی: موفق -->
    <color name="ds_success">@color/status_success</color>
    <color name="ds_success_container">@color/status_success_light</color>
    <color name="ds_success_on_container">#146C43</color>

    <!-- معنایی: هشدار -->
    <color name="ds_warning">@color/status_warning</color>

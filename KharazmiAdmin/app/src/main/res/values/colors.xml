    <color name="ds_danger_container">@color/status_danger_light</color>
    <color name="ds_danger_on_container">#8F1D18</color>
    <!-- DESIGN SYSTEM (Phase 2): سطح پرشده خطر — تیره‌تر از ds_danger تا متن سفید کنتراست ≥4.5 بگیرد -->
    <color name="ds_danger_deep">#B03A33</color>
    <color name="ds_danger_deep_pressed">#8E2B25</color>

    <!-- معنایی: اطلاع -->
    <color name="ds_info">@color/status_info</color>
    <color name="ds_info_container">@color/status_info_light</color>
    <color name="ds_info_on_container">#0B4A83</color>

    <!-- خنثی (برای چیپ/پیل‌های بی‌وضعیت) -->
    <color name="ds_neutral_container">@color/ds_bg_surface_3</color>

    <!-- مالی: بدهی/اعتبار — هرگز فقط با رنگ نمایش داده نشوند (متن/آیکون الزامی است) -->
    <color name="ds_debt_container">@color/status_danger_light</color>
